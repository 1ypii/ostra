{%- liquid
  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = ' scroll-trigger animate--slide-in'
  endif

  assign image_first = false
  if section.settings.layout == 'image_left'
    assign image_first = true
  endif
-%}

<section
  class="ostra-hero color-{{ section.settings.color_scheme }} gradient tw:grid tw:grid-cols-1 tw:md:grid-cols-12 tw:border-b tw:border-line"
  style="--hero-min: {{ section.settings.min_height }}svh;"
>
  <div class="tw:flex tw:flex-col tw:justify-end tw:gap-8 tw:px-6 tw:py-12 tw:md:col-span-5 tw:md:px-12 tw:md:py-16{% if image_first %} tw:md:order-2{% endif %}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="tw:text-xs tw:uppercase tw:tracking-[0.2em] tw:text-muted tw:m-0{{ reveal }}">
        {{ section.settings.eyebrow | escape }}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="ostra-hero__heading tw:font-heading tw:m-0 tw:text-6xl tw:md:text-8xl tw:leading-[0.92] tw:tracking-tight{{ reveal }}">
        {{ section.settings.heading | escape }}
      </h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="tw:max-w-md tw:text-base tw:text-muted tw:md:text-lg{{ reveal }}">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
      <div class="tw:flex tw:flex-wrap tw:gap-3 tw:pt-2{{ reveal }}">
        {%- if section.settings.button_label != blank -%}
          <a
            class="button"
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a
            class="button button--secondary"
            {% if section.settings.button_link_2 != blank %}
              href="{{ section.settings.button_link_2 }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            {{- section.settings.button_label_2 | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="ostra-hero__media tw:relative tw:overflow-hidden tw:md:col-span-7 tw:aspect-[4/5] tw:md:aspect-auto{% if image_first %} tw:md:order-1{% endif %}">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'tw:absolute tw:inset-0 tw:h-full tw:w-full tw:object-cover',
          widths: '600, 900, 1200, 1600, 2000, 2400',
          sizes: '(min-width: 750px) 60vw, 100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'tw:absolute tw:inset-0 tw:h-full tw:w-full tw:bg-line' }}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .ostra-hero {
    min-height: 0;
  }

  .ostra-hero__heading {
    color: rgb(var(--color-foreground));
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .ostra-hero {
      min-height: var(--hero-min);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ostra hero",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image_right", "label": "Image right" },
        { "value": "image_left", "label": "Image left" }
      ],
      "default": "image_right"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Small batch stoneware"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made slowly, used every day"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Wheel thrown mugs, plates and bowls glazed in quiet colours and fired twice for a surface that ages well.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop the range"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Our process"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Ostra hero"
    }
  ]
}
{% endschema %}
