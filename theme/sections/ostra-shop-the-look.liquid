{{ 'component-price.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient tw:grid tw:grid-cols-1 tw:md:grid-cols-12 tw:border-y tw:border-line">
  <ostra-look class="tw:relative tw:block tw:overflow-hidden tw:md:col-span-7 tw:aspect-[4/5]">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          class: 'tw:absolute tw:inset-0 tw:h-full tw:w-full tw:object-cover',
          widths: '600, 900, 1200, 1600, 2000',
          sizes: '(min-width: 750px) 60vw, 100vw',
          loading: 'lazy'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'tw:absolute tw:inset-0 tw:h-full tw:w-full tw:bg-line' }}
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- assign spot = block.settings.product -%}
      <div
        class="ostra-look__spot tw:absolute"
        style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;"
        data-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        <button
          type="button"
          class="ostra-look__dot"
          aria-expanded="false"
          aria-controls="LookCard-{{ block.id }}"
          aria-label="{{ spot.title | default: block.settings.fallback_title | escape }}"
        >
          <span class="ostra-look__pulse" aria-hidden="true"></span>
        </button>

        <div
          id="LookCard-{{ block.id }}"
          class="ostra-look__card color-{{ section.settings.card_color_scheme }} tw:flex tw:gap-3 tw:p-3{% if block.settings.x > 55 %} ostra-look__card--left{% endif %}"
          hidden
        >
          {%- if spot.featured_image -%}
            {{
              spot.featured_image
              | image_url: width: 160
              | image_tag: class: 'tw:h-20 tw:w-14 tw:shrink-0 tw:object-cover', loading: 'lazy'
            }}
          {%- endif -%}
          <div class="tw:flex tw:min-w-0 tw:flex-col tw:justify-center tw:gap-1">
            <p class="tw:m-0 tw:text-sm tw:leading-tight">{{ spot.title | default: block.settings.fallback_title | escape }}</p>
            {%- if spot != blank -%}
              <p class="tw:m-0 tw:text-sm tw:text-muted">{{ spot.price | money }}</p>
              <a href="{{ spot.url }}" class="link underlined-link tw:text-xs tw:uppercase tw:tracking-[0.15em]">
                {{- 'ostra.look.view' | t -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </ostra-look>

  <div class="tw:flex tw:flex-col tw:justify-between tw:gap-10 tw:px-6 tw:py-12 tw:md:col-span-5 tw:md:px-12 tw:md:py-16">
    <div class="tw:flex tw:flex-col tw:gap-4">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tw:m-0 tw:text-xs tw:uppercase tw:tracking-[0.2em] tw:text-muted">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="tw:font-heading tw:m-0 tw:text-4xl tw:md:text-6xl tw:tracking-tight">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="tw:max-w-md tw:text-muted">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <ol class="ostra-look__list tw:m-0 tw:list-none tw:p-0" role="list">
      {%- for block in section.blocks -%}
        {%- assign spot = block.settings.product -%}
        <li class="tw:border-t tw:border-line">
          <a
            {% if spot != blank %}href="{{ spot.url }}"{% endif %}
            class="ostra-look__item tw:flex tw:items-center tw:justify-between tw:gap-4 tw:py-4 tw:text-inherit tw:no-underline"
            data-index="{{ forloop.index0 }}"
          >
            <span class="tw:flex tw:items-center tw:gap-4">
              <span class="tw:w-6 tw:text-xs tw:text-muted">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span>{{ spot.title | default: block.settings.fallback_title | escape }}</span>
            </span>
            {%- if spot != blank -%}
              <span class="tw:text-sm tw:text-muted">{{ spot.price | money }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% stylesheet %}
  .ostra-look__spot {
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  .ostra-look__spot.is-open {
    z-index: 2;
  }

  .ostra-look__dot {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ostra-look__dot::after {
    content: '';
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: #2a2420;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ostra-look__dot:hover,
  .ostra-look__spot.is-active .ostra-look__dot,
  .ostra-look__dot[aria-expanded='true'] {
    transform: scale(1.15);
  }

  .ostra-look__dot[aria-expanded='true']::after {
    transform: scale(1.4);
  }

  .ostra-look__pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.8);
    animation: ostra-pulse 2.4s ease-out infinite;
  }

  @keyframes ostra-pulse {
    from {
      transform: scale(1);
      opacity: 1;
    }
    to {
      transform: scale(2);
      opacity: 0;
    }
  }

  .ostra-look__card {
    position: absolute;
    top: 50%;
    left: calc(100% + 1rem);
    width: 24rem;
    transform: translateY(-50%);
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    animation: ostra-card-in 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ostra-look__card[hidden] {
    display: none;
  }

  .ostra-look__card--left {
    left: auto;
    right: calc(100% + 1rem);
  }

  @keyframes ostra-card-in {
    from {
      opacity: 0;
      transform: translateY(calc(-50% + 0.6rem));
    }
  }

  .ostra-look__item {
    transition: padding 0.3s cubic-bezier(0.22, 1, 0.36, 1), color 0.3s ease;
  }

  .ostra-look__item:hover,
  .ostra-look__item.is-active {
    padding-left: 0.8rem;
  }

  @media screen and (max-width: 749px) {
    .ostra-look__card {
      width: 20rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ostra-look__pulse {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('ostra-look')) {
    customElements.define(
      'ostra-look',
      class extends HTMLElement {
        connectedCallback() {
          this.spots = [...this.querySelectorAll('.ostra-look__spot')];
          this.items = [...this.closest('.shopify-section').querySelectorAll('.ostra-look__item')];

          this.spots.forEach((spot) => {
            spot.querySelector('button').addEventListener('click', (e) => {
              e.stopPropagation();
              this.toggle(spot);
            });
          });

          this.items.forEach((item) => {
            item.addEventListener('mouseenter', () => this.highlight(item.dataset.index, true));
            item.addEventListener('mouseleave', () => this.highlight(item.dataset.index, false));
            item.addEventListener('focus', () => this.highlight(item.dataset.index, true));
            item.addEventListener('blur', () => this.highlight(item.dataset.index, false));
          });

          this.onOutside = (e) => {
            if (!this.contains(e.target)) this.closeAll();
          };
          this.onKey = (e) => {
            if (e.key === 'Escape') this.closeAll(true);
          };
          document.addEventListener('click', this.onOutside);
          document.addEventListener('keydown', this.onKey);
        }

        disconnectedCallback() {
          document.removeEventListener('click', this.onOutside);
          document.removeEventListener('keydown', this.onKey);
        }

        toggle(spot) {
          const open = !spot.classList.contains('is-open');
          this.closeAll();
          if (!open) return;
          spot.classList.add('is-open');
          spot.querySelector('button').setAttribute('aria-expanded', 'true');
          spot.querySelector('.ostra-look__card').hidden = false;
        }

        closeAll(refocus) {
          this.spots.forEach((spot) => {
            if (!spot.classList.contains('is-open')) return;
            spot.classList.remove('is-open');
            const button = spot.querySelector('button');
            button.setAttribute('aria-expanded', 'false');
            spot.querySelector('.ostra-look__card').hidden = true;
            if (refocus) button.focus();
          });
        }

        highlight(index, on) {
          this.spots[index]?.classList.toggle('is-active', on);
          this.items[index]?.classList.toggle('is-active', on);
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Ostra shop the look",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop the table"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A slow breakfast"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tap a piece to see it up close.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Product card color scheme",
      "default": "scheme-5"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "fallback_title",
          "label": "Title when no product is set",
          "default": "Product"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ostra shop the look",
      "blocks": [
        { "type": "hotspot", "settings": { "x": 35, "y": 60 } },
        { "type": "hotspot", "settings": { "x": 65, "y": 45 } }
      ]
    }
  ]
}
{% endschema %}
